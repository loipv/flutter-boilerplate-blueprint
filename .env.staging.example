# Staging environment variables.
# Copy this file to .env.staging and fill in real values.
# .env.staging is git-ignored and must never be committed.
#
# App Check debug tokens: register these UUIDs in Firebase Console under
#   <your-staging-project> -> App Check -> iOS app  -> Manage debug tokens
#   <your-staging-project> -> App Check -> Android app -> Manage debug tokens
# Generate new UUIDs with: uuidgen
APP_CHECK_DEBUG_TOKEN_IOS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_CHECK_DEBUG_TOKEN_ANDROID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Analytics & Error Tracking
POSTHOG_API_KEY=phc_xxxx
# Optional. Leave blank for PostHog Cloud default, or set your region/self-hosted host.
# Examples:
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_HOST=https://analytics.yourdomain.com
POSTHOG_HOST=
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Google Sign-In (Android only, web OAuth client ID)
# Found in android/app/src/staging/google-services.json
# -> oauth_client[] where client_type = 3
GOOGLE_SERVER_CLIENT_ID=xxxx.apps.googleusercontent.com

# Optional advanced auth setup. Set this only if you use a custom Firebase Auth
# redirect domain instead of the default generated one.
# Example:
# FIREBASE_AUTH_DOMAIN=staging-auth.yourdomain.com
FIREBASE_AUTH_DOMAIN=

# Base URL for your HTTP API. Default for ConfigKeys.apiBaseUrl when Remote
# Config has no value yet (first install, offline).
API_BASE_URL=

# BEGIN_REMOTE_CONFIG
# Optional. Value of the Remote Config custom signal "environment".
# Blank = flavor name (staging / production).
REMOTE_CONFIG_ENV=
# END_REMOTE_CONFIG
